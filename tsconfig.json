{
  "compilerOptions": {
    "outDir": "./dist/",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "target": "es2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noImplicitAny": true,
    "allowJs": true,
    "sourceMap": true,
    "rootDir": "./src"
  },
  "include": ["./src/**/*"]
}
